{
  "schemaVersion": 1,
  "apiVersion": 1,
  "id": "tooru.zashboard",
  "name": "zashboard",
  "author": "tooru",
  "authorUrl": "https://github.com/toorux",
  "version": "0.1.0-preview.15",
  "description": "在 Steam Frame 上使用 Mihomo 代理与 zashboard 管理面板。",
  "details": "离线内置 ARM64 Mihomo 与 zashboard。支持 Clash YAML 导入、HTTPS 订阅更新、规则/全局/直连模式和节点选择；首次安装默认关闭 TUN，局域网和组播流量绕过代理。root 后端通过 Framely 生命周期及独立守护进程管理内核。",
  "tags": [
    "网络",
    "代理",
    "工具"
  ],
  "icon": "icon.png",
  "backend": {
    "entry": "backend",
    "runAs": "root",
    "autostart": true,
    "restart": "on-failure",
    "restartLimit": 3
  },
  "lifecycle": {
    "onStart": true,
    "onStop": true,
    "onUninstall": {
      "entry": "backend",
      "args": [
        "--cleanup"
      ]
    },
    "onCrashCleanup": {
      "entry": "backend",
      "args": [
        "--cleanup"
      ]
    },
    "timeoutSeconds": 15
  },
  "ui": {
    "quickPage": "page.js",
    "windows": {
      "main": {
        "entry": "page.js",
        "title": "zashboard",
        "localWeb": true,
        "width": 1600,
        "height": 900,
        "widthMeters": 3.0,
        "dockIcon": true
      },
      "settings": {
        "entry": "page.js",
        "title": "zashboard · 配置管理",
        "dockIcon": true,
        "width": 1600,
        "height": 900,
        "widthMeters": 3.0
      },
      "dashboard": {
        "entry": "page.js",
        "title": "zashboard",
        "localWeb": true,
        "width": 1600,
        "height": 900,
        "widthMeters": 3.0,
        "dockIcon": true
      }
    }
  },
  "exclusiveResources": [
    "framely-zashboard.tun",
    "framely-clash.tun"
  ],
  "changelog": "完整面板及配置窗口统一使用带 Steam 工具栏的标准 Dock 窗口，修复旧 dashboard 入口打开固定平板 Overlay 的问题。",
  "files": {},
  "homepage": "https://github.com/toorux/framely-plugin-zashboard"
}
